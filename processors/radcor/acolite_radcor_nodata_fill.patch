+## reads a water mask for nodata_fill at the positions lon, lat
+## the file is a GeoTIFF in geographic coordinates (EPSG:4326, north up) with 1 for water
+## 2026-11-20
+
+def nodata_fill_mask(file, lon, lat):
+    import numpy as np
+    from osgeo import gdal
+
+    ds = gdal.Open('{}'.format(file))
+    if ds is None: raise ValueError('could not open the water mask {}'.format(file))
+    gt = ds.GetGeoTransform()
+    mask = ds.ReadAsArray()
+    ds = None
+    col = np.clip(np.floor((lon - gt[0]) / gt[1]).astype(int), 0, mask.shape[1] - 1)
+    row = np.clip(np.floor((lat - gt[3]) / gt[5]).astype(int), 0, mask.shape[0] - 1)
+    return(mask[row, col] == 1)
 
