+## def nodata_fill
+## fills the pixels without data (e.g. beyond the swath edge) of a TOA array before the RAdCor convolution
+## method = average: the given average, i.e. the scene average as before
+##        = nearest: the nearest pixel with data that lies at least inset pixels inside the data
+##        = water_mask: as nearest, but by class, water takes the nearest water pixel and land the nearest land pixel
+##          pixels within inset pixels of the other class are not copied from, they are mixed or misplaced in the mask
+## the pixels within inset pixels of the no data area are filled as well, since the last pixels before a swath edge
+## are not reliable
+## 2026-11-20
+
+def nodata_fill(x_a, average, method = 'average', inset = 0, water = None):
+    import numpy as np
+    import scipy.ndimage
+
+    gap = np.isnan(x_a)
+    if (method == 'average') or (not gap.any()):
+        x_a[gap] = average
+        return(x_a)
+    if method not in ('nearest', 'water_mask'):
+        raise ValueError('radcor_nodata_fill={} is not one of average, nearest, water_mask'.format(method))
+
+    if inset > 0: gap = scipy.ndimage.binary_dilation(gap, iterations = inset)
+    if gap.all(): ## nothing to copy from
+        x_a[np.isnan(x_a)] = average
+        return(x_a)
+
+    if method == 'nearest':
+        near = scipy.ndimage.distance_transform_edt(gap, return_distances = False, return_indices = True)
+        return(x_a[tuple(near)])
+
+    if (water is None) or (water.shape != x_a.shape):
+        raise ValueError('radcor_nodata_fill=water_mask needs a water mask with the shape of the image')
+    for cl in (True, False):
+        cls = water == cl
+        source = (~gap) & cls
+        if inset > 0: ## a pixel at the shore, taken for water, would fill the water beyond with the value of land
+            core = source & scipy.ndimage.binary_erosion(cls, iterations = inset, border_value = 1)
+            if core.any(): source = core
+        target = gap & cls
+        if source.any() and target.any():
+            near = scipy.ndimage.distance_transform_edt(~source, return_distances = False, return_indices = True)
+            x_a[target] = x_a[tuple(near)][target]
+    left = np.isnan(x_a)
+    if left.any(): ## a class without any pixel in the data: nearest pixel of any class
+        near = scipy.ndimage.distance_transform_edt(left | gap, return_distances = False, return_indices = True)
+        x_a[left] = x_a[tuple(near)][left]
+    return(x_a)
+
